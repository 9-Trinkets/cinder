#!/usr/bin/env bash
# Pre-commit hook source. Installed into .git/hooks/pre-commit by
# scripts/install_hooks.sh with the absolute repo root baked in. Runs warning-
# only health checks at every commit: file lengths and test organization.
# Always exits 0 so it never blocks a commit.
set -u
# REPO_ROOT is substituted at install time by install_hooks.sh.
REPO_ROOT="__CINDER_REPO_ROOT__"

if [ -f "$REPO_ROOT/scripts/check_file_lengths.py" ]; then
    python3 "$REPO_ROOT/scripts/check_file_lengths.py" || true
fi

if [ -f "$REPO_ROOT/scripts/check_test_placement.py" ]; then
    python3 "$REPO_ROOT/scripts/check_test_placement.py" || true
fi

exit 0
