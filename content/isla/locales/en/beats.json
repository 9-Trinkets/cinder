      "quest_title": "The session",
      "quest_kind": "main",
      "summary": "Stay with Wren.",
      "narrative_lines": [
        "The afternoon light lies across the rug. Wren is at the shelf between the two lidded bins, moving animals from one to the other. A cow. A pig. The small horse.",
        "Wren (to Isla): One. Two. Three.",
        "She stops herself. She puts the cow in the left bin, takes it out, and puts it in the right.",
        "Wren (to Isla): These ones live here."
      ],
      "open_menu": "bins",
      "advance_signals": [
        {
          "signal": "menu_selected:bins",
