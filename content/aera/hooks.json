{
  "actor.turn_action_guidance": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "active_stage_ids",
              "operator": "array_contains",
              "value": "introduce-everyone-first-evening"
            }
          ],
          "payload_template": {
            "kind": "hide_affordance",
            "affordance_id": "move"
          }
        }
      ]
    }
  },
  "actor.time_advanced": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "hunger",
            "delta": 1
          }
        }
      ]
    }
  },
  "actor.moved": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "stamina",
            "delta": -1
          }
        }
      ]
    }
  },
  "actor.rested": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "stamina",
            "delta": 2
          }
        }
      ]
    }
  },
  "actor.consumed": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "hunger_recovery",
              "operator": "greater_than",
              "value": 0
            }
          ],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "hunger",
            "delta": "-${input.hunger_recovery}"
          }
        },
        {
          "conditions": [
            {
              "path": "stamina_recovery",
              "operator": "greater_than",
              "value": 0
            }
          ],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "stamina",
            "delta": "$input.stamina_recovery"
          }
        }
      ]
    }
  },
  "actor.turn_should_rest": {
    "rule": "decision_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "value": false
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "stamina",
              "operator": "less_than",
              "value": 5
            },
            {
              "path": "has_rest_affordance",
              "operator": "equal",
              "value": true
            }
          ],
          "payload_template": {
            "value": true
          }
        }
      ]
    }
  },
  "actor.turn_should_consume": {
    "rule": "decision_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "value": false
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "hunger",
              "operator": "greater_than",
              "value": 5
            },
            {
              "path": "has_hunger_recovery_consumable",
              "operator": "equal",
              "value": true
            }
          ],
          "payload_template": {
            "value": true
          }
        }
      ]
    }
  },
  "actor.turn_should_move": {
    "rule": "decision_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "value": false
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "has_pending_movement_target",
              "operator": "equal",
              "value": true
            }
          ],
          "payload_template": {
            "value": true
          }
        }
      ]
    }
  },
  "actor.turn_should_cook": {
    "rule": "decision_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "value": false
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "cooking_needed",
              "operator": "equal",
              "value": true
            },
            {
              "path": "has_cook_affordance",
              "operator": "equal",
              "value": true
            },
            {
              "path": "food_stock_deficit",
              "operator": "greater_than",
              "value": 0
            }
          ],
          "payload_template": {
            "value": true
          }
        }
      ]
    }
  },
  "actor.turn_should_speak": {
    "rule": "decision_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "value": false
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "is_directly_addressed",
              "operator": "equal",
              "value": true
            }
          ],
          "payload_template": {
            "value": true
          }
        },
        {
          "conditions": [
            {
              "path": "has_clearly_preferred_target",
              "operator": "equal",
              "value": true
            }
          ],
          "payload_template": {
            "value": true,
            "chance": {
              "path": "confidence",
              "max": 10
            }
          }
        }
      ]
    }
  }
}
