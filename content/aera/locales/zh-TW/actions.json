{
  "actions": [
    {
      "id": "look",
      "label": "查看",
      "phrases": [
        "查看",
        "看",
        "看看",
        "環顧",
        "觀察",
        "檢查",
        "查看四周",
        "環顧四周"
      ],
      "ui": {
        "panel_config": {
          "title": "環顧四周",
          "prompt": "有什麼吸引了你的目光？"
        }
      },
      "player_command": {
        "usage": "look [at <thing or person>]（查看 [物品或人物]）",
        "example": "查看四周"
      }
    },
    {
      "id": "move",
      "label": "移動",
      "phrases": [
        "前往",
        "去",
        "往",
        "走",
        "移動",
        "進入",
        "爬",
        "登"
      ],
      "event_text": "{actor_name}前往{target_room_title}。",
      "ui": {
        "panel_config": {
          "title": "移動位置",
          "prompt": "你想去哪裡？"
        }
      },
      "player_command": {
        "usage": "go <room>（前往 <房間>）",
        "example": "前往 客廳"
      }
    },
    {
      "id": "interact",
      "label": "操作",
      "phrases": [
        "操作",
        "互動",
        "使用"
      ],
      "ui": {
        "panel_config": {
          "title": "操作物件",
          "prompt": "你想操作什麼？"
        }
      },
      "player_command": {
        "usage": "interact <target> or do <action>（操作 <目標> 或 執行 <動作>）",
        "example": "操作 關上 隔音門"
      }
    },
    {
      "id": "follow",
      "label": "跟隨",
      "phrases": [
        "跟隨",
        "跟上",
        "追蹤"
      ],
      "ui": {
        "panel_config": {
          "title": "追蹤鏡頭",
          "prompt": "鏡頭要追蹤哪位房客？"
        }
      },
      "player_command": {
        "usage": "follow <person>（跟隨 <人物>）",
        "example": "跟隨 蓮"
      }
    },
    {
      "id": "rest",
      "label": "休息",
      "phrases": [
        "休息",
        "歇息",
        "坐下休息",
        "喘口氣"
      ],
      "event_text": "{actor_name}在{context_label}安靜地休息片刻。",
      "player_command": {
        "usage": "rest（休息）",
        "example": "休息"
      }
    },
    {
      "id": "speak",
      "label": "交談",
      "phrases": [
        "交談",
        "對話",
        "說話",
        "聊天"
      ],
      "player_command": {
        "usage": "speak <person> [message]（與 <人物> 對話 [內容]）",
        "example": "與 艾拉 對話 早安",
        "input": {
          "prompt": "你想說什麼？",
          "placeholder": "說些真誠自然的話..."
        }
      }
    },
    {
      "id": "inspect_feature",
      "label": "檢視物件",
      "phrases": [
        "檢視",
        "細看",
        "查看物件"
      ],
      "event_text": "{actor_name}仔細檢視了{feature_label}。",
      "player_command": {
        "usage": "inspect <thing>（檢視 <物件>）",
        "example": "檢視 料理中島"
      }
    },
    {
      "id": "act",
      "label": "行動",
      "phrases": [
        "行動",
        "做",
        "執行"
      ]
    }
  ]
}
