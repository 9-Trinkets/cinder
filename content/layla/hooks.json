{
  "actor.defeated": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [
            {
              "path": "actor_id",
              "operator": "equal",
              "value": "golem-boss"
            }
          ],
          "payload_template": {
            "kind": "set_story_var",
            "key": "warden_defeated",
            "value": "true"
          }
        }
      ]
    }
  },
  "item.salve_used": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "adjust_actor_stat",
            "actor_id": "$input.actor_id",
            "stat": "hp",
            "delta": 4
          }
        }
      ]
    }
  },
  "actor.surrounded": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "convert_actor_to_ally",
            "actor_id": "$input.actor_id",
            "follows_player": true,
            "messages": [
              "conversion.encircled",
              "conversion.encircled_follows"
            ]
          }
        }
      ]
    }
  },
  "item.ring_equipped": {
    "rule": "effect_table",
    "rule_config": {
      "cases_path": "rules",
      "next_on_match": "complete",
      "next_on_default": "complete",
      "default_payload_template": {
        "effects": []
      }
    },
    "input_overlay": {
      "rules": [
        {
          "conditions": [],
          "payload_template": {
            "kind": "convert_allies_by_tag",
            "tag": "golem",
            "follows_player": true,
            "messages": [
              "conversion.ring"
            ]
          }
        }
      ]
    }
  }
}