    {
      "id": "mq_infiltrate_sanctuary",
      "quest_id": "high_sanctuary_infiltration",
      "quest_title": "The High Sanctuary",
      "quest_kind": "main",
      "summary": "Use the clandestine token to infiltrate the High Sanctuary alone.",
      "beat_note": "Layla enters Floor 6 alone using the clandestine sanctuary token. Her party remains on Floor 5 until the main teleport platform is unlocked.",
      "update_message": "Infiltrate the High Sanctuary alone using the clandestine token.",
      "narrative_lines": [
        "Astrid lowers her great shield and points toward the towering white spire rising through the mountain clouds above.",
        "Astrid: The Frost Citadel is secure, Layla, but our path to the Royal Core is blocked. High above us sits Floor 6—the High Sanctuary. Its brass gates are sealed from within. Our army cannot storm those walls from the outside. If we want to reach the throne, someone must slip inside and activate their master teleport platform.",
        "Einar steps forward, his expression grave as he clutches his herbalist satchel.",
        "Einar: That cathedral is not a place of prayer, Layla. Before they threw me into the cages down here, I worked in their dispensary. The high clergy takes every person executed in this citadel, wipes their memories, and turns them into the monsters you've been fighting all the way up this tower. The man conducting this horror is their high priest, Seer Valerius.",
        "Einar: Valerius hides the ritual behind thick illusions, but someone inside can help. My partner, Orva, is trapped in the cathedral herb gardens. The priests call her 'the Witch' because she secretly brews remedies to resist their mind-wiping magic. She is also... the woman I love.",
        "Einar presses a silver token, three bottles of blue invisibility potion, and a silver hairpin shaped like a feathered arrow into your hands.",
        "Einar: This token can slip only one person through their outer wards. Drink these invisibility potions to walk past the white-armored cathedral guards unseen. Find Orva in the herb garden. Show her this arrow pin and tell her: 'The arrow always finds home.' She will give you the spirit pill to reveal Valerius's ritual and defeat him. Once the Seer falls, activate the master platform so Astrid and the rest of us can join you."
      ],
      "on_advance_effects": [
        {
          "kind": "grant_item",
          "item_id": "clandestine-sanctuary-token"
        },
        {
          "kind": "grant_item",
          "item_id": "invisibility-potion",
          "count": 3
        },
        {
          "kind": "grant_item",
          "item_id": "silver-arrow-pin"
        }
      ],
      "advance_signals": [
        {
          "signal": "story_vars_changed",
          "conditions": [
            {
              "path": "story_vars.values.entered_floor6",
              "operator": "equal",
              "value": "true"
            }
          ]
        }
      ],
      "next_stage_ids": [
        "mq_find_the_witch",
        "sq_archive_of_the_disappeared"
      ],
      "completion_effects": []
    },
