{
  "actions": [
    {
      "id": "look",
      "label": "查看",
      "phrases": [
        "查看",
        "看",
        "看看",
        "環顧",
        "觀察",
        "檢查",
        "查看四周",
        "環顧四周"
      ],
      "ui": {
        "panel_config": {
          "title": "環顧四周",
          "prompt": "有什麼吸引了你的目光？"
        }
      },
      "player_command": {
        "usage": "look [at <thing or person>]（查看 [物品或人物]）",
        "example": "查看四周"
      }
    },
    {
      "id": "move",
      "label": "移動",
      "phrases": [
        "前往",
        "去",
        "往",
        "走",
        "移動",
        "進入"
      ],
      "event_text": "{actor_name}前往{target_room_title}。",
      "ui": {
        "panel_config": {
          "title": "要去哪裡？",
          "prompt": "選擇一個方向"
        }
      },
      "player_command": {
        "usage": "go <exit>（前往 <方向>）",
        "example": "前往 北"
      }
    },
    {
      "id": "speak",
      "label": "交談",
      "phrases": [
        "交談",
        "對話",
        "說話",
        "談話"
      ],
      "ui": {
        "panel_config": {
          "title": "你想跟誰說話？",
          "prompt": "選擇要交談的對象"
        }
      },
      "player_command": {
        "usage": "talk to <person> [message]（交談 <人物> [內容]）",
        "example": "交談 魔像"
      }
    },
    {
      "id": "take",
      "label": "拿取",
      "phrases": [
        "拿",
        "拿取",
        "撿",
        "撿起",
        "拾取"
      ],
      "ui": {
        "panel_config": {
          "title": "房間裡",
          "prompt": ""
        }
      },
      "player_command": {
        "usage": "take <item>（拿取 <物品>）",
        "example": "拿取 鑿斧"
      }
    },
    {
      "id": "give",
      "label": "給予",
      "phrases": [
        "給予"
      ],
      "ui": {
        "panel_config": {
          "title": "交給隊友",
          "prompt": "選擇要給出的物品"
        }
      },
      "player_command": {
        "usage": "give <item> to <companion>（給予 <物品> to <隊友>）",
        "example": "給予 藥水 to 小宰德"
      }
    },
    {
      "id": "drop",
      "label": "放下",
      "phrases": [
        "放下",
        "丟下",
        "丟棄"
      ],
      "ui": {
        "panel_config": {
          "title": "放下物品",
          "prompt": ""
        }
      },
      "player_command": {
        "usage": "drop <item>（放下 <物品>）",
        "example": "放下 石頭"
      }
    },
    {
      "id": "do",
      "label": "行動",
      "phrases": [
        "做",
        "行動"
      ],
      "player_command": {
        "usage": "do <what to do>（行動 <做什麼>）",
        "example": "行動 打開籠子"
      }
    },
    {
      "id": "erase",
      "label": "抹去符印",
      "phrases": [
        "抹去",
        "擦掉",
        "抹除",
        "擦除"
      ],
      "player_command": {
        "usage": "erase [sigil]（抹去 [符印]）",
        "example": "抹去"
      }
    }
  ]
}
