      "player_command": {
        "usage": "unlock gate（打開大門）",
        "example": "打開大門"
      },
      "content_event": {
        "event_text": "你把沉重的黃銅鑰匙插進隔艙門鎖，重重轉動，發出一聲尖銳的金屬悶響。沉重的液壓門閂縮了回去，封死的要塞大門鬆開了。"
      }
    },
    {
      "id": "unlock_courtyard_cages",
      "label": "打開籠子",
      "phrases": [
        "打開籠子",
        "開籠",
        "解鎖籠子",
        "解救囚犯",
        "放出祭品"
