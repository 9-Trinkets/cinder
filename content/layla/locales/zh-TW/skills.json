          "毆打",
          "戰鬥",
          "殺"
        ],
        "event_text": "{actor_name}攻擊了{target_actor_name}。",
        "ui": {
          "panel_config": {
            "title": "你想攻擊誰？",
            "prompt": "選擇一個目標"
          }
        },
        "player_command": {
          "usage": "attack <target>（攻擊 <目標>）",
          "example": "攻擊 哥布林"
        }
      }
    },
    {
      "id": "intercept",
      "label": "攔截",
