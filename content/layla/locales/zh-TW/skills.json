      "player_action": {
        "id": "trace",
        "label": "描紋",
        "phrases": [
          "描紋",
          "描繪",
          "畫線",
          "畫",
          "使用粉筆"
        ],
        "ui": {
          "panel_config": {
            "title": "銘刻",
            "prompt": "選擇要描繪的記號"
          }
