      "scaling": {
        "summary_template": "吸收傷害：-{damage_soaked}"
      }
    },
    {
      "id": "heal",
      "label": "治療",
      "description": "為受傷的同伴開啟安撫的藥劑，恢復體力。",
      "scaling": {
        "summary_template": "回復：{amount} 點體力"
      }
    },
    {
      "id": "trace",
      "label": "描紋",
      "description": "在石頭上刻下閃著光的戰術粉筆符紋。",
