        "content_event": {
          "event_text": "蕾拉蹲下身，在地上畫出一道粉筆線。它亮起淡淡而穩定的光，留在了那裡。"
        }
      }
    },
    {
      "id": "teleport",
      "label": "傳送",
      "description": "把隊伍瞬間送回已啟動的傳送錨點。",
      "scaling": {
        "summary_template": "錨點：{anchor_capacity}"
